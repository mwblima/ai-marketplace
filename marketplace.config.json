    "repoUrl": "https://github.com/mwblima/ai-marketplace"
  },
  "catalogRoot": "catalog",
  "pluginsRoot": "plugins",

  "teams": {
    "platform": { "name": "Platform Engineering", "email": "platform@acme.example" },
    "backend": { "name": "Backend Engineering", "email": "backend@acme.example" },
